# Environment variables for the client app.
# Note that variables, that start with "REACT_APP" prefix, are exposed to the public web.
# https://create-react-app.dev/docs/adding-custom-environment-variables

# Mandatory configuration
#
# Note: You also need to set Stripe secret key in Sharetribe Console.
#
REACT_APP_SHARETRIBE_SDK_CLIENT_ID=change-me
REACT_APP_STRIPE_PUBLISHABLE_KEY=
REACT_APP_MAPBOX_ACCESS_TOKEN=

# If you are using a process with privileged transitions,
# Client Secret needs to be set too. The one related to Client ID.
# You get this at Sharetribe Console (Build -> Applications -> Add new).
SHARETRIBE_SDK_CLIENT_SECRET=

# Integration API credentials. These are a SEPARATE application from the
# Marketplace API client above — create one at Console -> Build -> Applications
# and pick "Integration API", not "Marketplace API". Server-only: never prefix
# these with REACT_APP_, they grant full admin access to the marketplace.
#
# REQUIRED for the laundry feature. Without them:
#   - new users are not given metadata.isLaundry = false, so an operator has no
#     property to toggle in Console (POST /api/init-user-role)
#   - the listing wizard's laundry picker returns nothing (/api/laundries)
#   - laundry status transitions and the availability buffer cannot be written
# The endpoints that need these are deliberately fire-and-continue, so a missing
# value fails quietly rather than breaking signup or a booking — which means the
# symptom is a feature that silently does nothing, not an error page.
SHARETRIBE_INTEGRATION_SDK_CLIENT_ID=
SHARETRIBE_INTEGRATION_SDK_CLIENT_SECRET=

# Or set up an alternative map provider (Google Maps). Check documentation.
# REACT_APP_GOOGLE_MAPS_API_KEY=

# Server-only fallback for the booking cleaning-fee line item (Cocloset laundry
# feature). Plain number in the marketplace's major currency unit (e.g. 12.5 for
# EUR 12.50) - never prefix with REACT_APP_, it must not reach the browser.
# Used only when a booking's assigned laundry hasn't set its own
# privateData.cleaningFee (see LaundryProfilePage). Optional - if unset, the
# cleaning fee defaults to 0.
# DEFAULT_CLEANING_FEE=10

# Server-only fallback laundry turnaround time (Cocloset laundry feature),
# used to size the availability-exception buffer window blocked around a
# booking (see server/api/create-availability-buffer.js). In hours - never
# prefix with REACT_APP_, it must not reach the browser. Used only when a
# booking's assigned laundry hasn't set its own privateData.turnaroundHours
# (see LaundryProfilePage). Optional - if unset, falls back to a hardcoded
# 48 hours.
# DEFAULT_LAUNDRY_BUFFER_HOURS=48

# Mailgun (Cocloset laundry feature). Server-only - never prefix any of these
# with REACT_APP_, an API key that reaches the browser is a compromised key.
#
# Used by server/api-util/mailgun.js to send the four laundry-facing
# notifications in Project Overview 3.12 (New Incoming Garment, Pickup
# Scheduled, Return Scheduled, Cleaning Required). Those cannot be native
# Sharetribe notifications: a process notification can only be addressed to
# the transaction's customer or provider, and a Laundry Shop is neither.
#
# ALL OPTIONAL. If MAILGUN_API_KEY is unset, sending is silently skipped -
# no error, no log noise, no HTTP call - so local dev, CI and the test suite
# run without credentials. Set the key only where mail should really go out.
#
# MAILGUN_DOMAIN is the verified sending domain (required alongside the key -
# a key without a domain is treated as a misconfiguration and logged).
# MAILGUN_FROM_EMAIL is the sender; if unset it defaults to
# no-reply@<MAILGUN_DOMAIN>. Accepts "Name <address>" form.
# MAILGUN_API_BASE_URL only needs setting for EU-hosted Mailgun domains -
# sending an EU domain's mail at the default US host fails with a 401 that
# looks exactly like a bad API key.
# MAILGUN_API_KEY=change-me
# MAILGUN_DOMAIN=mg.example.com
# MAILGUN_FROM_EMAIL=Cocloset <no-reply@mg.example.com>
# MAILGUN_API_BASE_URL=https://api.eu.mailgun.net

# Defaults
#

# Host/domain - don't use trailing slash: "/"
REACT_APP_MARKETPLACE_ROOT_URL=http://localhost:3000

# Marketplace name
# If not set, this defaults to 'Biketribe' in src/config/configDefault.js
REACT_APP_MARKETPLACE_NAME=

# Social logins && SSO
# If the app or client id is not set the auhtentication option is not shown in the Template
REACT_APP_FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

REACT_APP_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# This is overwritten by configuration in .env.development and
# .env.test. In production deployments use env variable and set it to
# 'production'
REACT_APP_ENV=production


# CSP. You can use value 'report' or 'block'.
# If the env varibale is missing, csp is disabled.
REACT_APP_CSP=report

# Options. Uncomment and set to test.
#

# REACT_APP_SHARETRIBE_USING_SSL=true
# SERVER_SHARETRIBE_TRUST_PROXY=true
# REACT_APP_SENTRY_DSN=change-me
# BASIC_AUTH_USERNAME=sharetribe
# BASIC_AUTH_PASSWORD=secret

# This is GA4 id, which should start with 'G-' prefix.
# You should also turn "Enhanced measurements" off from GA.
# https://support.google.com/analytics/answer/9216061
# REACT_APP_GOOGLE_ANALYTICS_ID=change-me

# This adds data-domains for Plausible script
# If you add this environment variable, you should have created an account in plausible.io
# You can add multiple domains separated by comma. 
# E.g. REACT_APP_PLAUSIBLE_DOMAINS=example1.com,example2.com
# REACT_APP_PLAUSIBLE_DOMAINS=my.marketplace.com

# Cache configuration for the proxied SDK calls. 0 means no caching.
# This is applied to the asset endpoints only, and by default:
# - assets by version is cached for 1 day
# - asset by alias is not cached by default (because it would add an extra buffer before changes to marketplace config are applied)
# TTL=60
# TTL_ASSETS_BY_VERSION=86400

# Debugging and reducing load from server
# VERBOSE=true
# PREVENT_DATA_LOADING_IN_SSR=true

# Mailgun, used for the emails Sharetribe cannot send itself: laundry-facing
# notifications (a laundry is not a party to the transaction, so the process cannot
# address mail to it) and laundry-partner applications.
# Sending is SKIPPED SILENTLY when MAILGUN_API_KEY is unset, so local development and
# CI work without credentials. Server-only — never prefix these with REACT_APP_.
# MAILGUN_API_KEY=change-me
# MAILGUN_DOMAIN=mg.example.com
# MAILGUN_FROM_EMAIL=Cocloset <no-reply@mg.example.com>
# Only needed for an EU-hosted Mailgun domain. Sending an EU domain to the default US
# host fails with a 401 that looks exactly like a bad API key.
# MAILGUN_API_BASE_URL=https://api.eu.mailgun.net

# Where laundry-partner applications submitted on /become-a-partner are delivered.
#
# The operator inbox that receives each application as an email (via Mailgun above).
# This is the intended destination — set both this and the Mailgun vars.
# CONFIGURE THIS BEFORE THE PARTNER LANDING PAGE GOES LIVE.
# SERVER_LAUNDRY_PARTNER_APPLICATION_EMAIL=partners@example.com
#
# Optional, and independent of the email above: also POST each application as JSON to a
# webhook — a Slack incoming webhook, a Zapier/Make catch hook, a form backend. Useful if
# applications should land in an existing tool rather than an inbox.
# SERVER_LAUNDRY_PARTNER_APPLICATION_WEBHOOK_URL=https://hooks.example.com/change-me
#
# With neither set, the only record of an application is a `[laundry-partner-application]`
# line in the server log stream.
