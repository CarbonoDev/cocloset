   :on :transition/cancel-from-returned,
   :to :actor.role/customer,
   :template :booking-cancelled}
  {:name :notification/booking-cancelled-from-returned-to-provider,
   :on :transition/cancel-from-returned,
   :to :actor.role/provider,
   :template :booking-cancelled-owner}

  ;; -------------------------------------------------------------------
  ;; Reviews
  ;;
  ;; ONE-SIDED NOW (2026-09-21). :transition/review-1-by-provider,
  ;; review-2-by-provider and review-2-by-customer are gone along with the
  ;; provider's ability to review at all - see :transition/review-1-by-customer
  ;; above. That transition now runs :action/publish-reviews in the same
  ;; step, so the provider's notification changes from "a review is waiting,
  ;; unpublished, for your own review to unlock it" to "a review was posted
  ;; and is already live" - :booking-review-by-other-party-published, not
  ;; -unpublished, even though this is the renter's FIRST (only) review.
  ;; -------------------------------------------------------------------

  {:name :notification/review-by-customer-first,
   :on :transition/review-1-by-customer,
   :to :actor.role/provider,
   :template :booking-review-by-other-party-published}]}
